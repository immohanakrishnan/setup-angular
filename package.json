{
  "name": "setup-angular",
  "version": "1.0.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immohanakrishnan/setup-angular.git"
  },
  "homepage": "https://github.com/immohanakrishnan/setup-angular#readme",
  "bugs": {
    "url": "https://github.com/immohanakrishnan/setup-angular/issues"
  },
  "description": "A production-oriented Angular workspace setup CLI with enterprise architecture presets.",
  "keywords": [
    "angular",
    "angular-cli",
    "cli",
    "starter",
    "scaffold",
    "project-generator"
  ],
  "type": "module",
  "bin": {
    "setup-angular": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "bin"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/semver": "^7.7.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
